APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000

# Redis commands retry short Docker Desktop stalls instead of failing a task.
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=10
REDIS_SOCKET_TIMEOUT_SECONDS=30
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=15
REDIS_RETRY_ATTEMPTS=5

CHUNK_SIZE_FRAMES=64
CHUNK_OVERLAP_FRAMES=16
# Keep one Ray chunk per active video and at most two chunks globally.
# Local ingest decodes one archive entry at a time; downstream stays parallel.
MAX_DECODED_CHUNK_BYTES=83886080
MAX_INFLIGHT_CHUNKS_PER_TASK=1
MAX_INFLIGHT_CHUNKS_GLOBAL=2
INGEST_BACKPRESSURE_POLL_SECONDS=0.1
DOWNSTREAM_STALL_TIMEOUT_SECONDS=120
VIDEO_PROBE_TIMEOUT_SECONDS=900
DECODE_BATCH_TIMEOUT_SECONDS=120
FFMPEG_DECODE_THREADS=1
RAY_PUT_TIMEOUT_SECONDS=60
RAY_PUT_MAX_ATTEMPTS=2
RAY_PUT_RETRY_DELAY_SECONDS=1
RAY_ACTOR_CALL_TIMEOUT_SECONDS=30

# Size-based ZIP admission: the combined accepted video payload is limited to
# 4 GiB regardless of how many supported videos fit inside it.
MAX_UPLOAD_BYTES=4294967296
MAX_ARCHIVE_UPLOAD_BYTES=4294967296
MAX_ARCHIVE_VIDEO_BYTES=4294967296
MAX_ARCHIVE_UNCOMPRESSED_BYTES=8589934592
MAX_ARCHIVE_MEMBERS=2000
MAX_ARCHIVE_COMPRESSION_RATIO=100
ARCHIVE_DISK_RESERVE_BYTES=536870912

# Hide short Redis/status-read hiccups from API clients; persistent failures
# are returned as 503 Service Unavailable instead of an opaque 500.
STATUS_READ_MAX_ATTEMPTS=3
STATUS_READ_RETRY_DELAY_SECONDS=0.05
# Retry a failed chunk immediately before later chunks are consumed.
STREAM_RETRY_DELAY_SECONDS=0.5
STREAM_PROCESSING_HEARTBEAT_SECONDS=15
# No artificial latency in local mock actors.
MOCK_WORKER_DELAY_MS=0
PROGRESS_UPDATE_EVERY_CHUNKS=1
# Archive entries remain unlimited by count, but local decoding is queued one
# video at a time so a multi-gigabyte ZIP cannot exhaust Docker Desktop RAM.
INGEST_WORKER_CONCURRENCY=1
CUT_WORKER_CONCURRENCY=2
COORDINATOR_WORKER_CONCURRENCY=4
TRACKING_WORKER_CONCURRENCY=2
AGGREGATOR_WORKER_CONCURRENCY=2
ALLOW_REMOTE_URLS=false

# Safe defaults for a local Docker Desktop mock run.
RAY_SHM_SIZE=512mb
RAY_OBJECT_STORE_BYTES=268435456
# Local mock mode: Docker Desktop may report nearly all VM memory as used.
# Disable Ray's worker-killing monitor here; production should override to 250.
RAY_MEMORY_MONITOR_REFRESH_MS=0
RAY_MEMORY_USAGE_THRESHOLD=0.99
RAY_INCLUDE_DASHBOARD=false

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Real model profile (`compose.ml.example.yaml`). Keep model binaries in ./models.
ML_INFERENCE_TIMEOUT_SECONDS=600
ML_WORKER_SHM_SIZE=1gb
ML_RAY_OBJECT_STORE_BYTES=268435456
ML_RAY_NODE_CPUS=4
ML_RAY_NODE_GPUS=1
ML_CUT_WORKER_CONCURRENCY=1
ML_TRACKING_WORKER_CONCURRENCY=1
ML_MAX_INFLIGHT_CHUNKS_PER_TASK=1
ML_MAX_INFLIGHT_CHUNKS_GLOBAL=1
CUT_MODEL_WEIGHTS_PATH=/models/weights_for_cut.pth
CUT_MODEL_ARCH_DIR=/models/autoshot_arch
CUT_MODEL_ALLOW_DOWNLOAD=false
CUT_MODEL_THRESHOLD=0.55
CUT_MODEL_NUM_GPUS=0.5
TRACKING_MODEL_ID=/models/yoloe26l_military_assets.pt
TRACKING_MODEL_CLASSES=[]
TRACKING_MODEL_CONFIDENCE=0.25
TRACKING_MODEL_IMAGE_SIZE=960
TRACKING_MODEL_ALLOW_DOWNLOAD=false
TRACKING_MODEL_NUM_GPUS=0.5
