{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "API Requests / 5m",
      "targets": [
        {
          "expr": "sum(increase(cv_api_requests_total[5m]))"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Completed Tasks",
      "targets": [
        {
          "expr": "sum(cv_tasks_completed_total)"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Host Memory Usage",
      "targets": [
        {
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "GPU Utilization",
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Redis Memory",
      "targets": [
        {
          "expr": "redis_memory_used_bytes"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Worker Errors",
      "targets": [
        {
          "expr": "sum by (worker) (rate(cv_worker_errors_total[5m]))"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "timeseries",
      "title": "/dev/shm Usage",
      "targets": [
        {
          "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/dev/shm\"} / node_filesystem_size_bytes{mountpoint=\"/dev/shm\"}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    }
  ],
  "schemaVersion": 41,
  "tags": [
    "cv",
    "video",
    "pipeline"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "CV Video Analysis Pipeline",
  "uid": "cv-video-analysis",
  "version": 2
